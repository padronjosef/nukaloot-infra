# Domain nginx serves, read by deploy.sh when regenerating its config.
WEB_APP_DOMAIN=nukaloot.com

# --- Admin panel (/admin) ---
# Generate each with: openssl rand -hex 32

# Shared between the web and api containers. The analytics and user endpoints
# reject any call that does not carry it.


# Signs the admin session cookie. At least 32 characters.
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Salts the hash that counts unique visitors. Changing it re-buckets every
# visitor, so set it once and leave it alone.
ANALYTICS_VISITOR_SALT=

# Signs the short-lived bearer tokens the web sends to the API. The API
# verifies them itself, so reaching it over the internal network is not enough
# to call it. Both containers need the same value.
API_JWT_SECRET=

# Creates the first admin, and only while the users table is empty — so it
# cannot overwrite an existing account. Change the password from the panel
# after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Days a visitor's IP is kept on a search before it is erased. The row itself
# is kept forever — only the address goes. Defaults to 7 when unset.
SEARCH_LOG_IP_RETENTION_DAYS=7

# When the sweep runs, in UTC: day 0 is Sunday, 6 is Saturday.
# Because it runs weekly, an address outlives the window above by up to seven
# days — with 7 days set, addresses are cleared somewhere between 7 and 14.
SEARCH_LOG_SWEEP_DAY=0
SEARCH_LOG_SWEEP_HOUR=4

# --- Sending email (needed for sign-up confirmation and, later, alarms) ---
# Cloudflare Email Routing only RECEIVES. To send, create a Resend account,
# verify nukaloot.com there (it gives you DNS records to add in Cloudflare),
# and paste the key. With these empty nothing is sent: the API logs the
# confirmation link instead, which is enough for local development.
RESEND_API_KEY=
MAIL_FROM=Nukaloot <hola@nukaloot.com>

# Accounts that never follow the confirmation link are deleted after this many
# days, during the weekly sweep. Defaults to 7.
UNVERIFIED_ACCOUNT_DAYS=7

# --- Sign in with Google (optional) ---
# Leave empty and the "Continue with Google" button is simply not shown.
#
# Create an OAuth 2.0 Client ID of type "Web application" in the Google Cloud
# Console, and register these redirect URIs on it:
#   http://localhost:3003/api/auth/google/callback   (local)
#   https://<your domain>/api/auth/google/callback   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the callback is not <site origin>/api/auth/google/callback.
GOOGLE_REDIRECT_URI=
